# SQLingo Desktop Backend - Environment Variables
# Copy this file to .env and edit as needed:
#   cp env.example .env

# ── Server ───────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
RELOAD=True

# Internal port used by Electron to find the backend.
# Must match VITE_DESKTOP_BACKEND_PORT in frontend/.env
DESKTOP_BACKEND_PORT=39847

# ── Optional: Ollama ──────────────────────────────────────────────────────────
# Override the default Ollama URL if you run it on a different host/port.
# OLLAMA_BASE_URL=http://localhost:11434
